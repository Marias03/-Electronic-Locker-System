generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Casillero {
  id        Int      @id @default(autoincrement())
  numero    Int      @unique
  tamanio   String
  ocupado   Boolean  @default(false)
  usuario   String?
  email     String?
  pin       String?
  reservadoEn DateTime?
  sucursalId  Int?
  sucursal    Sucursal? @relation(fields: [sucursalId], references: [id])
  createdAt DateTime @default(now())
}
model Historial {
  id        Int      @id @default(autoincrement())
  numero    Int
  tamanio   String
  usuario   String?
  email     String?
  accion    String
  createdAt DateTime @default(now())
}
model Pago {
  id        Int      @id @default(autoincrement())
  numero    Int
  tamanio   String
  usuario   String?
  email     String?
  monto     Int
  createdAt DateTime @default(now())
}

model Sucursal {
  id         Int         @id @default(autoincrement())
  nombre     String
  tipo       String
  ciudad     String
  direccion  String
  lat        Float
  lng        Float
  slug       String      @unique
  activa     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  casilleros Casillero[]
}